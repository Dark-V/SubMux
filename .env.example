# Optional. Leave empty to let SubMux generate and persist one in /data/admin_token.
ADMIN_TOKEN=
# Set to 1 when the admin panel is served through HTTPS.
COOKIE_SECURE=0

# Persistent upstream and bundle cache TTL in seconds (default 30 min).
CACHE_TTL_SECONDS=1800

# Internal listeners. Default host mapping: admin :81, public :8081.
ADMIN_PORT=8080
PUBLIC_PORT=8081

# Optional external reverse-proxy URL shown/copied by the panel.
# Example: https://sub.example.com
PUBLIC_BASE_URL=
